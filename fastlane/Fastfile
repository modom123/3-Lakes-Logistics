default_platform(:android)

platform :android do

  desc "Upload AAB to Google Play internal track"
  lane :upload_to_play do |options|
    aab_path = options[:aab] || Dir["android/app/build/outputs/bundle/release/*.aab"].first

    UI.user_error!("No AAB found. Run the Android build first.") unless aab_path && File.exist?(aab_path)

    upload_to_play_store(
      track:              "internal",
      aab:                aab_path,
      package_name:       "com.threelakes.driver",
      release_status:     "draft",
      version_name:       options[:version_name] || "1.0.0",
      skip_upload_apk:    true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      metadata_path:      "fastlane/metadata/android"
    )

    UI.success("AAB uploaded to Play Store internal track!")
  end

  desc "Promote internal build to production"
  lane :promote_to_production do
    upload_to_play_store_internal_app_sharing(
      package_name: "com.threelakes.driver"
    )
    upload_to_play_store(
      track:        "internal",
      track_promote_to: "production",
      package_name: "com.threelakes.driver",
      skip_upload_apk: true,
      skip_upload_aab: true
    )
    UI.success("App promoted to production!")
  end

end
