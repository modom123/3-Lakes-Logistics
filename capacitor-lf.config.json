{
  "appId": "com.threelakes.lightfleet",
  "appName": "3 Lakes Light Fleet",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "appendUserAgent": "3LakesLightFleet/1.0",
    "backgroundColor": "#0a0a1a",
    "buildOptions": {
      "keystorePath": "3lakes-release.keystore",
      "keystoreAlias": "threelakes-lf"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a1a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "App": {
      "iosScheme": "3lakeslightfleet",
      "androidScheme": "https"
    }
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "https://three-lakes-logistics-api.onrender.com",
      "https://zngipootstubwvgdmckt.supabase.co"
    ]
  }
}
