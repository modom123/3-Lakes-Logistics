{
  "version": 2,
  "name": "3-lakes-logistics",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "routes": [
    { "src": "/shared/(.*)",          "dest": "/shared/$1" },
    { "src": "/driver-pwa/(.*)",      "dest": "/driver-pwa/$1" },
    { "src": "/marketing/(.*)",       "dest": "/marketing/$1" },
    { "src": "/eagle-eye",            "dest": "/eagleeye.html" },
    { "src": "/ops",                  "dest": "/eagleeye.html" },
    { "src": "/admin",                "dest": "/eagleeye.html" },
    { "src": "/(.*\\.html)",          "dest": "/$1" },
    { "src": "/(.*\\.js)",            "dest": "/$1" },
    { "src": "/(.*\\.css)",           "dest": "/$1" },
    { "src": "/(.*\\.xml)",           "dest": "/$1" },
    { "src": "/(.*\\.txt)",           "dest": "/$1" },
    { "src": "/(.*\\.json)",          "dest": "/$1" },
    { "src": "/(.*\\.ico)",           "dest": "/$1" },
    { "src": "/(.*\\.png)",           "dest": "/$1" },
    { "src": "/(.*\\.svg)",           "dest": "/$1" },
    { "src": "/(.*)",                 "dest": "/index.html" }
  ]
}
