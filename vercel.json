{
  "version": 2,
  "name": "3-lakes-logistics",
  "cleanUrls": true,
  "routes": [
    { "src": "/(.*)", "headers": { "cache-control": "no-cache, max-age=0, must-revalidate" }, "continue": true },
    { "src": "/shared/(.*)",          "dest": "/shared/$1" },
    { "src": "/driver-pwa/(.*)",      "dest": "/driver-pwa/$1" },
    { "src": "/admin",                "dest": "/eagleeye.html" },
    { "src": "/eagleeye",             "dest": "/eagleeye.html" },
    { "src": "/hawk",                 "dest": "/hawk.html" },
    { "src": "/driver",               "dest": "/hawk.html" },
    { "src": "/(.*\\.html)",          "dest": "/$1" },
    { "src": "/(.*\\.js)",            "dest": "/$1" },
    { "src": "/(.*\\.css)",           "dest": "/$1" },
    { "src": "/(.*\\.json)",          "dest": "/$1" },
    { "src": "/(.*\\.ico)",           "dest": "/$1" },
    { "src": "/(.*\\.png)",           "dest": "/$1" },
    { "src": "/(.*\\.svg)",           "dest": "/$1" },
    { "src": "/(.*)",                 "dest": "/eagleeye.html" }
  ]
}
