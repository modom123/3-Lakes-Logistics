{
  "version": 2,
  "name": "3-lakes-logistics",
  "cleanUrls": true,
  "routes": [
    { "src": "/(.*)", "headers": { "cache-control": "no-cache, max-age=0, must-revalidate" }, "continue": true },
    { "src": "/shared/(.*)",          "dest": "/shared/$1" },
    { "src": "/driver-pwa/(.*)",      "dest": "/driver-pwa/$1" },
    { "src": "/admin",                "dest": "/eagleeye.html" },
    { "src": "/eagleeye",             "dest": "/eagleeye.html" },
    { "src": "/hawk",                 "dest": "/hawk.html" },
    { "src": "/driver",               "dest": "/hawk.html" },
    { "src": "/(.*\\.html)",          "dest": "/$1" },
    { "src": "/(.*\\.js)",            "dest": "/$1" },
    { "src": "/(.*\\.css)",           "dest": "/$1" },
    { "src": "/(.*\\.json)",          "dest": "/$1" },
    { "src": "/(.*\\.ico)",           "dest": "/$1" },
    { "src": "/(.*\\.png)",           "dest": "/$1" },
    { "src": "/(.*\\.svg)",           "dest": "/$1" },
    { "src": "/carrier-agreement",            "dest": "/carrier-agreement.html" },
    { "src": "/broker-agreement",             "dest": "/broker-agreement.html" },
    { "src": "/independent-contractor-agreement", "dest": "/independent-contractor-agreement.html" },
    { "src": "/non-solicitation-agreement",   "dest": "/non-solicitation-agreement.html" },
    { "src": "/driver-lease-on-agreement",    "dest": "/driver-lease-on-agreement.html" },
    { "src": "/fuel-advance-agreement",       "dest": "/fuel-advance-agreement.html" },
    { "src": "/dispatcher-service-agreement", "dest": "/dispatcher-service-agreement.html" },
    { "src": "/cargo-claims-procedure",       "dest": "/cargo-claims-procedure.html" },
    { "src": "/rate-confirmation-template",   "dest": "/rate-confirmation-template.html" },
    { "src": "/insurance-requirements",       "dest": "/insurance-requirements.html" },
    { "src": "/factoring-acknowledgment",     "dest": "/factoring-acknowledgment.html" },
    { "src": "/nda",                          "dest": "/nda.html" },
    { "src": "/terms-of-service",             "dest": "/terms-of-service.html" },
    { "src": "/privacy-policy",               "dest": "/privacy-policy.html" },
    { "src": "/data-safety",                  "dest": "/data-safety.html" },
    { "src": "/sign",                         "dest": "/sign.html" },
    { "src": "/light-fleet",                  "dest": "/light-fleet.html" },
    { "src": "/light-fleet-marketing",        "dest": "/light-fleet-marketing.html" },
    { "src": "/(.*)",                         "dest": "/eagleeye.html" }
  ]
}
